# SAARTHII environment reference
#
# This file is documentation only. Vite reads frontend/.env.local and
# FastAPI reads backend/.env. Use the per-application example files:
#   frontend/.env.example  -> frontend/.env.local
#   backend/.env.example   -> backend/.env
#
# Only publishable/anon keys may appear in frontend variables.
# Service-role keys and database passwords are backend-only.
# Never commit a real .env file.

# Backend
PROJECT_NAME="SAARTHII"
VERSION="1.0.0"
API_V1_STR="/api"
BACKEND_PORT=8000
BACKEND_HOST=127.0.0.1
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
SECRET_KEY="replace-with-a-long-random-value"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Backend-only Supabase configuration
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_OR_SECRET_KEY
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUD=authenticated
SUPABASE_STORAGE_BUCKET=referral-documents
SUPABASE_REQUEST_TIMEOUT_SECONDS=5
