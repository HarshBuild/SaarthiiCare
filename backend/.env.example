# SAARTHII backend environment example
# Copy to backend/.env and replace every placeholder locally.
# NEVER commit backend/.env or put these values in frontend VITE_* variables.

PROJECT_NAME="SAARTHII"
VERSION="1.0.0"
API_V1_STR="/api"
BACKEND_PORT=8000
BACKEND_HOST=127.0.0.1
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
SECRET_KEY="replace-with-a-long-random-value"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Supabase server-side configuration
# Rotate any key that has been pasted into chat or committed before use.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_OR_SECRET_KEY
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUD=authenticated
SUPABASE_STORAGE_BUCKET=referral-documents
SUPABASE_REQUEST_TIMEOUT_SECONDS=5

# Legacy/local database placeholder. The Supabase URL above is the target.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saarthii
